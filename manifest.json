{
  "manifest_version": 3,
  "name": "LingoSync Translator",
  "version": "1.1.0",
  "description": "Translates chat in real-time with ChatGPT voice plugins",
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "activeTab"
  ]
}